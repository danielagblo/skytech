PassengerAppRoot /home/u362798031/domains/skytechghana.com/hbuilds/current/nodejs
PassengerAppType node
PassengerNodejs /opt/alt/alt-nodejs22/root/bin/node
PassengerStartupFile server.js
PassengerBaseURI /
PassengerRestartDir /home/u362798031/domains/skytechghana.com/hbuilds/current/nodejs/tmp
SetEnv NODE_OPTIONS "--require /home/u362798031/domains/skytechghana.com/hbuilds/config/preload-timestamp.js"
SetEnv LSNODE_CONSOLE_LOG console.log
SetEnv TOKIO_WORKER_THREADS 2

# 1. Prevent Hostinger and browser caching of HTML entry files
<FilesMatch "\.(html|htm)$">
    FileETag None
    <IfModule mod_headers.c>
        Header unset ETag
        Header set Cache-Control "max-age=0, no-cache, no-store, must-revalidate"
        Header set Pragma "no-cache"
        Header set Expires "Wed, 11 Jan 1984 05:00:00 GMT"
    </IfModule>
</FilesMatch>

# 2. Allow long-term caching of hashed Next.js scripts
<FilesMatch "\.(js|css|woff|woff2|png|jpg|jpeg|svg)$">
    <IfModule mod_headers.c>
        Header set Cache-Control "public, max-age=31536000, immutable"
    </IfModule>
</FilesMatch>
