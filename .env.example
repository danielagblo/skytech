# MongoDB connection string (used when DB_TYPE=mongodb)
MONGODB_URI=mongodb://localhost:27017/skytech

# Database driver: mongodb | mysql
DB_TYPE=mongodb

# Image storage: s3 | db (db = stored in MySQL LONGBLOB)
IMAGE_STORAGE=s3

# MySQL (Hostinger) configuration
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DATABASE=skytech
# Set to 1 to connect over TLS (required by some Hostinger databases)
MYSQL_SSL=0

# S3 Configuration (used when IMAGE_STORAGE=s3)
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_ENDPOINT=
S3_BUCKET=

# Public base URL (used to build absolute image URLs)
NEXT_PUBLIC_BASE_URL=http://localhost:3000

# Admin password for the dashboard
ADMIN_PASSWORD=<change-me>

# Arkesel SMS
ARKESEL_API_KEY=
ARKESEL_SENDER_ID=Skytech